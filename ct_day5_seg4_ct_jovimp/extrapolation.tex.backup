\begin{slide}
Extrapolation
 \begin{itemize}
 \item System Dynamics and Transition Matrix Structure
 \item Transition Matrix Accumulation
 \item State Extrapolation and Covariance Extrapolation
\end{itemize}
\end{slide}

\begin{slide}
System Dynamics and Transition Matrix Structure
\begin{itemize}
  \item Block partitioning based on Varying and Non-varying states
  \item Singer used $A$ for system dynamics matrix and $F$ for state transition matrix
	\begin{itemize}
		\item instead of usual $F$ for system dynamics and $\Phi$ for transition matrix
	\end{itemize}
\end{itemize} 

\end{slide}

\begin{slide}
System Dynamics and Transition Matrix Structure
\begin{itemize}
  \item $\Phi$ block structure: 
\end{itemize} 
\begin{equation}
\Phi = 
\begin{bmatrix}
F_{\text{vv}} & F_{\text{nv}}\\
0 & I
\end{bmatrix}
\end{equation} 
where $F_{\text{vv}}$ is the block propagating varying states, while $F_{\text{nv}}$ propagates non-varying states.
\end{slide}

