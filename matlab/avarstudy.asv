%avarstudy.m
clear;
numSamp=1000;

tau=0.001:.;
sigma=0.000;
clock_deltas = tau + sigma*randn(1,numSamp);
ticks = zeros(1,numSamp);
for i=2:numSamp
    ticks(i)=ticks(i-1)+clock_deltas(i);
end

% AVAR:

sum=0;
for i=1:numSamp-2
    sum = sum + (ticks(i+2)-2*ticks(i+1)+ticks(i))/tau;
end

avar = 1/(2*(numSamp-2))* sum;
display(avar)



