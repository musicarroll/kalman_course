    }
    Block {
      BlockType		      Constant
      Name		      "Constant1"
      Position		      [110, 365, 140, 395]
      Orientation	      "up"
      Value		      "1"
      VectorParams1D	      on
    }
    Block {
      BlockType		      Integrator
      Name		      "Integrator"
      Ports		      [1, 1]
      Position		      [85, 110, 115, 140]
      ExternalReset	      "none"
      InitialConditionSource  "internal"
