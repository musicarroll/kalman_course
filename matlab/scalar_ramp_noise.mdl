      Name		      "gain"
      Labels		      [0, 0]
      SrcBlock		      "Compute Gain"
      SrcPort		      1
      Points		      [0, -20]
      DstBlock		      "Mux"
      DstPort		      2
    }
    Line {
      SrcBlock		      "Unit Delay"
      SrcPort		      1
      Points		      [-25, 0; 0, -110]
      DstBlock		      "Mux"
      DstPort		      3
    }
    Line {
      SrcBlock		      "Integrator"
      SrcPort		      1
      DstBlock		      "Sum"
      DstPort		      1
    }
    Line {
      SrcBlock		      "Mux1"
      SrcPort		      1
      DstBlock		      "Scope"
      DstPort		      1
    }
    Annotation {
      Position		      [253, 59]
      Text		      "Scalar, Ramp Dynamics \nplus White Process Nois"
