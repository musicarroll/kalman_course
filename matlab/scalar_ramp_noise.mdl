      Position		      [115, 320, 135, 340]
      Orientation	      "left"
      NamePlacement	      "alternate"
      ShowName		      off
      IconShape		      "round"
      Inputs		      "|++"
      SaturateOnIntegerOverflow	on
    }
    Block {
      BlockType		      UnitDelay
      Name		      "Unit Delay"
      Position		      [265, 345, 300, 385]
      Orientation	      "left"
      FontSize		      10
      X0		      "0"
      SampleTime	      "-1"
    }
    Block {
      BlockType		      ZeroOrderHold
      Name		      "Zero-Order\nHold"
      Position		      [185, 106, 220, 144]
      SampleTime	      ".1"
      Port {
	PortNumber		1
	Name			"noisy neasurement"
	TestPoint		off
	LinearAnalysisOutput	off
	LinearAnalysisInput	off
	RTWStorageClass		"Auto"
      }
    }
    Block {
      BlockType		      ZeroOrderHold
      Name		      "Zero-Order\nHold1"
      Position		      [345, 346, 380, 384]
      Orientation	      "left"
      SampleTime	      "1"
    }
    Block {
      BlockType		      MATLABFcn
      Name		      "recursive_avg()"
      Position		      [305, 220, 365, 250]
      MATLABFcn		      "recursive_avg(u(1),u(2),u(3))"
      OutputDimensions	      "-1"
      OutputSignalType	      "auto"
      Output1D		      on
      Port {
	PortNumber		1
	Name			"state estimate"
	TestPoint		off
	LinearAnalysisOutput	off
	LinearAnalysisInput	off
	RTWStorageClass		"Auto"
      }
    }
    Line {
      SrcBlock		      "Band-Limited\nWhite Noise"
      SrcPort		      1
      Points		      [30, 0]
      DstBlock		      "Sum"
      DstPort		      2
    }
    Line {
      SrcBlock		      "Constant"
      SrcPort		      1
      DstBlock		      "Integrator"
      DstPort		      1
    }
    Line {
      SrcBlock		      "Sum"
      SrcPort		      1
      DstBlock		      "Zero-Order\nHold"
      DstPort		      1
    }
    Line {
      Name		      "state estimate"
      Labels		      [0, 0]
      SrcBlock		      "recursive_avg()"
      SrcPort		      1
      Points		      [0, -10; 40, 0]
      Branch {
	Labels			[1, 0]
	Points			[0, -70]
	DstBlock		"Mux1"
	DstPort			2
      }
      Branch {
	Points			[0, 140]
	DstBlock		"Zero-Order\nHold1"
	DstPort			1
      }
    }
    Line {
      SrcBlock		      "Mux"
      SrcPort		      1
      DstBlock		      "recursive_avg()"
      DstPort		      1
    }
    Line {
      SrcBlock		      "Clock"
      SrcPort		      1
      DstBlock		      "Sum1"
      DstPort		      1
    }
    Line {
      SrcBlock		      "Constant1"
      SrcPort		      1
      DstBlock		      "Sum1"
      DstPort		      2
    }
    Line {
      SrcBlock		      "Sum1"
      SrcPort		      1
      Points		      [-15, 0]
      DstBlock		      "Compute Gain"
      DstPort		      1
    }
    Line {
      Name		      "noisy neasurement"
      Labels		      [0, 0]
      SrcBlock		      "Zero-Order\nHold"
