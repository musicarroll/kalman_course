    Open		    on
    ModelBrowserVisibility  off
    ModelBrowserWidth	    200
    ScreenColor		    "automatic"
    PaperOrientation	    "landscape"
    PaperPositionMode	    "auto"
    PaperType		    "usletter"
    PaperUnits		    "inches"
    ZoomFactor		    "100"
    AutoZoom		    on
    ReportName		    "simulink-default.rpt"
    Block {
      BlockType		      Gain
      Name		      "-c/m"
      Position		      [230, 175, 260, 205]
      Orientation	      "left"
      NamePlacement	      "alternate"
      Gain		      "-c/m"
      Multiplication	      "Element-wise(K.*u)"
      SaturateOnIntegerOverflow	on
    }
    Block {
      BlockType		      Gain
      Name		      "-k/m"
      Position		      [340, 250, 370, 280]
      Orientation	      "left"
      NamePlacement	      "alternate"
      Gain		      "-k/m"
      Multiplication	      "Element-wise(K.*u)"
      SaturateOnIntegerOverflow	on
    }
    Block {
      BlockType		      Constant
      Name		      "Constant"
      Position		      [40, 65, 70, 95]
      Value		      "0"
      VectorParams1D	      on
    }
    Block {
      BlockType		      Integrator
      Name		      "Integrator"
      Ports		      [1, 1]
      Position		      [340, 90, 370, 120]
      ExternalReset	      "none"
      InitialConditionSource  "internal"
      InitialCondition	      "10"
      LimitOutput	      off
      UpperSaturationLimit    "inf"
      LowerSaturationLimit    "-inf"
      ShowSaturationPort      off
      ShowStatePort	      off
      AbsoluteTolerance	      "auto"
      Port {
	PortNumber		1
	Name			"position"
	TestPoint		off
	LinearAnalysisOutput	off
	LinearAnalysisInput	off
	RTWStorageClass		"Auto"
      }
    }
    Block {
      BlockType		      Integrator
      Name		      "Integrator1"
      Ports		      [1, 1]
      Position		      [230, 90, 260, 120]
      ExternalReset	      "none"
      InitialConditionSource  "internal"
      InitialCondition	      "0"
      LimitOutput	      off
      UpperSaturationLimit    "inf"
      LowerSaturationLimit    "-inf"
      ShowSaturationPort      off
      ShowStatePort	      off
      AbsoluteTolerance	      "auto"
      Port {
	PortNumber		1
	Name			"velocity"
	TestPoint		off
	LinearAnalysisOutput	off
	LinearAnalysisInput	off
	RTWStorageClass		"Auto"
      }
    }
    Block {
      BlockType		      Reference
      Name		      "Manual Switch"
      Ports		      [2, 1]
      Position		      [105, 87, 135, 123]
      SourceBlock	      "simulink3/Nonlinear/Manual Switch"
      SourceType	      "Manual Switch"
      sw		      "1"
      action		      "0"
    }
    Block {
      BlockType		      Scope
      Name		      "Scope"
      Ports		      [2]
      Position		      [505, 50, 535, 125]
      Floating		      off
      Location		      [25, 149, 349, 513]
      Open		      on
      NumInputPorts	      "2"
      TickLabels	      "OneTimeTick"
      ZoomMode		      "on"
      List {
	ListType		AxesTitles
	axes1			"%<SignalLabel>"
	axes2			"%<SignalLabel>"
      }
      Grid		      "on"
      TimeRange		      "auto"
      YMin		      "-5~-5"
      YMax		      "5~5"
      SaveToWorkspace	      off
      SaveName		      "ScopeData"
      DataFormat	      "StructureWithTime"
      LimitDataPoints	      on
      MaxDataPoints	      "5000"
      Decimation	      "1"
      SampleInput	      off
      SampleTime	      "0"
    }
    Block {
      BlockType		      Sin
      Name		      "Sine Wave"
      Position		      [40, 140, 70, 170]
      Amplitude		      "1"
      Frequency		      "1"
      Phase		      "0"
      SampleTime	      "0"
      VectorParams1D	      on
    }
    Block {
      BlockType		      Sum
      Name		      "Sum"
      Ports		      [2, 1]
      Position		      [160, 180, 180, 200]
      Orientation	      "up"
      ShowName		      off
      IconShape		      "round"
      Inputs		      "|++"
      SaturateOnIntegerOverflow	on
    }
    Block {
      BlockType		      Sum
      Name		      "Sum2"
      Ports		      [2, 1]
      Position		      [160, 95, 180, 115]
      ShowName		      off
      IconShape		      "round"
      Inputs		      "|++"
      SaturateOnIntegerOverflow	on
    }
    Line {
      Name		      "velocity"
      Labels		      [2, 0]
      SrcBlock		      "Integrator1"
      SrcPort		      1
      Points		      [0, 0; 30, 0]
      Branch {
	Points			[0, 85]
	DstBlock		"-c/m"
	DstPort			1
      }
      Branch {
	Points			[15, 0]
	Branch {
	  DstBlock		  "Integrator"
	  DstPort		  1
	}
	Branch {
	  Points		  [0, -35]
	  DstBlock		  "Scope"
	  DstPort		  1
	}
      }
    }
    Line {
      SrcBlock		      "-c/m"
      SrcPort		      1
      DstBlock		      "Sum"
      DstPort		      2
    }
    Line {
      SrcBlock		      "-k/m"
      SrcPort		      1
      Points		      [-165, 0]
      DstBlock		      "Sum"
      DstPort		      1
    }
    Line {
      Name		      "position"
      Labels		      [2, 0]
      SrcBlock		      "Integrator"
      SrcPort		      1
      Points		      [0, 0; 50, 0]
      Branch {
	Points			[0, 160]
	DstBlock		"-k/m"
	DstPort			1
      }
      Branch {
	DstBlock		"Scope"
	DstPort			2
      }
    }
    Line {
      SrcBlock		      "Sum"
      SrcPort		      1
      DstBlock		      "Sum2"
      DstPort		      2
    }
    Line {
      SrcBlock		      "Manual Switch"
      SrcPort		      1
      DstBlock		      "Sum2"
      DstPort		      1
    }
    Line {
      SrcBlock		      "Sum2"
      SrcPort		      1
      DstBlock		      "Integrator1"
      DstPort		      1
    }
    Line {
      SrcBlock		      "Constant"
      SrcPort		      1
      Points		      [15, 0]
      DstBlock		      "Manual Switch"
      DstPort		      1
    }
    Line {
      SrcBlock		      "Sine Wave"
      SrcPort		      1
      Points		      [15, 0]
      DstBlock		      "Manual Switch"
      DstPort		      2
    }
    Annotation {
      Position		      [216, 40]
      Text		      "Damped Harmonic Oscillator\n2-State Determinist"
"ic Problem"
      FontSize		      16
    }
  }
