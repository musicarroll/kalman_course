\begin{slide}
  Vector Dynamics: Simple Harmonic Oscillator
 \begin{itemize}
 \item Matlab Model
 \item 2-dimensional Vector Dynamics
 \item Deterministic, Continuous Model
\[
\begin{bmatrix}
\dot{x}_1\\
\dot{x}_2
\end{bmatrix} =
\begin{bmatrix}
0 & 1\\
-k/m & -c/m
\end{bmatrix}
\begin{bmatrix}
x_1\\
x_2
\end{bmatrix}
\]
\end{itemize}
\end{slide}
\begin{slide}
\begin{center}
\includegraphics[angle=-90,width=.80\textwidth]{day1_seg3_state_space/damped_harmosc_det.eps}
\end{center}
\end{slide}

\begin{slide}
  Vector Dynamics: Damped Harmonic Oscillator
 \begin{itemize}
 \item Discrete model would look like this
\[\begin{bmatrix}
x_{1}(k)\\
x_{2}(k)
\end{bmatrix}=\exp
\left(
\begin{bmatrix}
0 & 1\\
-k/m & -c/m
\end{bmatrix}
 \Delta t
\right)
\begin{bmatrix}
x_{1}(k-1)\\
x_{2}(k-1)
\end{bmatrix}
\]
\item Here $\Delta t=t_k - t_{k-1}$
\item Note that $\exp$ is a matrix exponential.
\item In the continuous case, the state transition matrix is a matrix exponential whenever the system dynamics matrix is a constant (i.e., time invariant) matrix. 
\end{itemize}
\end{slide}
