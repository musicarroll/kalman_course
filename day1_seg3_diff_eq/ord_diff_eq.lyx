\begin_inset Formula $n=2$
\end_inset

): 
\begin_inset Formula \begin{align*}
  c_1y_1(0)+c_2y_2(0) & =y(0) \\
  c_1Dy_1(0)+c_2Dy_2(0) & =Dy(0)
\end{align*}
\end_inset

 or 
\begin_inset Formula \begin{align*}
  1\cdot c_1+1\cdot c_2 & =0 \\
  -3.3028\cdot c_1+0.3028\cdot c_2 & =-1
\end{align*}
\end_inset

 
