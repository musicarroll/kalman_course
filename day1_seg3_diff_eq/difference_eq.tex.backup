% difference_eq.tex
\begin{slide}
Ordinary Difference Equations
\begin{itemize}
  \item Auto-Regressive Moving Average (ARMA)
  \item $n^{\text{th}}$ derivative corresponds to $n$-step advance:
\end{itemize} 
\begin{equation}\label{armaeq}
\armaeq
\end{equation}
\end{slide}
\begin{slide}
Ordinary Difference Equations
\begin{itemize}
  \item The left side of Eq. \eqref{armaeq} is the Auto-Regressive part
  \item The right side of Eq. \eqref{armaeq} is the Moving Average part
  \item Hence, ARMA
\end{itemize} 
\end{slide}
\begin{slide}
Ordinary Difference Equations: Example
\begin{itemize}
  \item Let $n=3$, $m=2$ and consider the difference equation:
\begin{align*}
-3y(k+3)+1.5y(k+2)\\
 +7y(k+1)-3.2y(k)\\
&=23u(k+2)-5u(k+1)+0.5u(k)
\end{align*}
\end{itemize} 
\end{slide}
