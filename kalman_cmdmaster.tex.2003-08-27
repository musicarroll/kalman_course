\newcommand{\rsint}[2]{\rsintfull{a}{b}{#1}{#2}}
\newcommand{\rsintfull}[4]{\int_{#1}^{#2}#3(t)d#4(t)}
\newcommand{\drsint}[2]{\iint\limits_{\crect{a}{b}}#1(s)#1(t)d_{s}d_{t}#2(s,t)}
\newcommand{\rint}[1]{\int_{a}^{b}#1dt}
\newcommand{\shortexp}[1]{\text{E}#1}
